# ─── General ──────────────────────────────────────────────────────────────────

# Path to the log file that stores sent report IDs (default: log.txt)
LOG_FILE=/app/data/log.txt

# Seconds to wait between sending each report (to avoid rate limits)
FETCH_DELAY=5

# HTTP request timeout in seconds
REQUEST_TIMEOUT=30

# Seconds to wait between each poll to the API (default: 300 seconds = 5 minutes)
POLL_INTERVAL=300

# ─── Discord ──────────────────────────────────────────────────────────────────

# Set to true to enable Discord notifications
DISCORD_ENABLED=false

# Your Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# (Optional) Discord Role ID to ping when a new report is posted
# Leave empty to disable role pinging
DISCORD_ROLE_ID=

# ─── Pagination ───────────────────────────────────────────────────────────────
# Number of reports to fetch per page
PAGE_SIZE=25

# ─── Logger ───────────────────────────────────────────────────────────────────
# Enable/disable stdout logging (true/false)
LOG_STDOUT_ENABLE=true
# Log level for stdout (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_STDOUT_LEVEL=INFO

# Enable/disable file logging (true/false)
LOG_FILE_ENABLE=true
# Log level for file (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_FILE_LEVEL=DEBUG
# Full path to the log file for logger output
LOG_FILE_PATH=/app/data/app.log